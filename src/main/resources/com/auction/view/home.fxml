<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: #003c3a;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.controller.HomeController" stylesheets="@../style/seller.css">

    <top>
        <VBox alignment="CENTER_RIGHT" spacing="10.0" style="-fx-padding: 15;">
            <Label fx:id="welcomeLabel" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #d4af37;" />
        </VBox>
    </top>

    <center>
        <VBox alignment="CENTER" spacing="20.0" style="-fx-padding: 10 30 10 30;">
            <Label style="-fx-font-size: 28px; -fx-font-weight: bold;" text="Dashboard" textFill="#d4af37" />

            <TableView fx:id="productTable" maxWidth="800.0" prefHeight="330.0" prefWidth="650.0">
                <columns>
                    <TableColumn fx:id="nameColumn" prefWidth="180.0" text="Name" />
                    <TableColumn fx:id="startPriceColumn" prefWidth="140.0" text="Start Price" />
                    <TableColumn fx:id="currentPriceColumn" prefWidth="160.0" text="Current Price" />
                    <TableColumn fx:id="statusColumn" prefWidth="169.0" text="Status" />
                    <TableColumn fx:id="timeLeftColumn" prefWidth="140.0" text="Time Left" />
                </columns>
            </TableView>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER" spacing="200.0" style="-fx-padding: 15;">
            <Button onAction="#handleRefresh" prefHeight="34.0" prefWidth="72.0" style="-fx-font-weight: bold; -fx-background-color: #50c878;" text="Refresh" />
            <Button mnemonicParsing="false" onAction="#handleViewDetail" prefHeight="34.0" prefWidth="113.0" style="-fx-font-weight: bold; -fx-background-color: #d3d3d3;" text="Bid now" />
            <Button onAction="#handleLogout" prefHeight="34.0" prefWidth="75.0" style="-fx-font-weight: bold; -fx-background-color: #b71c1c;" text="Logout" />
        </HBox>
    </bottom>

</BorderPane>
