<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="650.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.controller.ProductDetailController">

   <children>
      <VBox layoutX="150.0" layoutY="30.0" prefHeight="590.0" prefWidth="500.0" spacing="12.0">
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>

         <children>
            <Label text="Product Detail">
               <font>
                  <Font size="24.0" />
               </font>
            </Label>

            <Label fx:id="productNameLabel" text="Name:" />

            <Label fx:id="descriptionLabel" text="Description:" wrapText="true" />

            <Label fx:id="currentPriceLabel" text="Current Price:" />

            <Label fx:id="statusLabel" text="Status:" />

            <TextField fx:id="bidAmountField" promptText="Nhập mức giá thầu" />

            <Button fx:id="placeBidButton" mnemonicParsing="false" onAction="#handlePlaceBid" text="Đặt giá" />

            <Label text="Bid History">
               <font>
                  <Font size="20.0" />
               </font>
            </Label>

            <TableView fx:id="bidHistoryTable" prefHeight="220.0" prefWidth="460.0">
               <columns>
                  <TableColumn fx:id="bidderUsernameColumn" prefWidth="130.0" text="Bidder" />
                  <TableColumn fx:id="bidPriceColumn" prefWidth="148.0" text="Bid price" />
                  <TableColumn fx:id="bidTimeColumn" prefWidth="182.0" text="Time" />
               </columns>
            </TableView>

            <Button fx:id="backButton" mnemonicParsing="false" onAction="#handleBack" text="Back" />
         </children>
      </VBox>
   </children>
</AnchorPane>
