<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="450.0" prefWidth="500.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.controller.EditProductController">

    <children>
        <Label layoutX="30.0" layoutY="25.0" text="EDIT PRODUCT">
            <font>
                <Font size="24.0" />
            </font>
        </Label>

        <Label layoutX="30.0" layoutY="85.0" text="Name:" />
        <TextField fx:id="nameField" layoutX="150.0" layoutY="80.0" prefWidth="280.0" promptText="Nhập tên:" />

        <Label layoutX="30.0" layoutY="130.0" text="Description:" />
        <TextArea fx:id="descriptionArea" layoutX="150.0" layoutY="125.0" prefHeight="90.0" prefWidth="280.0" promptText="Nhập mô tả sản phẩm:" />

        <Label layoutX="30.0" layoutY="240.0" text="Start Price:" />
        <TextField fx:id="startPriceField" layoutX="150.0" layoutY="235.0" prefWidth="280.0" promptText="Nhập giá khởi điểm" />

        <Label layoutX="30.0" layoutY="285.0" text="Status:" />
        <ComboBox fx:id="statusComboBox" layoutX="150.0" layoutY="280.0" prefWidth="280.0" />

        <Button layoutX="150.0" layoutY="355.0" onAction="#handleSave" prefWidth="120.0" text="Save" />

        <Button layoutX="310.0" layoutY="355.0" onAction="#handleCancel" prefWidth="120.0" text="Cancel" />
    </children>
</AnchorPane>
