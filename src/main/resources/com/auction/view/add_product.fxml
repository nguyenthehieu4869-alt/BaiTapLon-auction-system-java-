<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.text.Font?>
<AnchorPane prefHeight="400.0" prefWidth="500.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.auction.controller.AddProductController">

    <children>
        <Label layoutX="30.0" layoutY="25.0" text="ADD PRODUCT">
            <font>
                <Font size="24.0" />
            </font>
        </Label>

        <Label layoutX="30.0" layoutY="85.0" text="Name:" />
        <TextField fx:id="nameField"
                   layoutX="150.0"
                   layoutY="80.0"
                   prefWidth="280.0" />

        <Label layoutX="30.0" layoutY="130.0" text="Description:" />
        <TextArea fx:id="descriptionArea"
                  layoutX="150.0"
                  layoutY="125.0"
                  prefWidth="280.0"
                  prefHeight="90.0" />

        <Label layoutX="30.0" layoutY="240.0" text="Start Price:" />
        <TextField fx:id="startPriceField"
                   layoutX="150.0"
                   layoutY="235.0"
                   prefWidth="280.0" />

        <Button layoutX="150.0"
                layoutY="300.0"
                prefWidth="120.0"
                text="Save"
                onAction="#handleSave" />

        <Button layoutX="310.0"
                layoutY="300.0"
                prefWidth="120.0"
                text="Cancel"
                onAction="#handleCancel" />
    </children>
</AnchorPane>
