<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="700.0" prefWidth="1200.0" style="-fx-background-color: linear-gradient(to bottom right, #031c1f, #08313a);" stylesheets="@../style/style.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.controller.HomeController">

    <top>
        <VBox spacing="10.0" style="-fx-padding: 22 32 8 32;">
            <HBox alignment="CENTER_LEFT" spacing="12.0">
                <Label style="-fx-font-size: 28px; -fx-font-weight: 900; -fx-text-fill: #f5d76e;" text="Bidder Dashboard" />
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="welcomeLabel" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #cde8e6;" />
                <Button onAction="#handleViewProfile" prefHeight="34.0" prefWidth="98.0" style="-fx-font-weight: bold; -fx-background-color: #d4af37; -fx-text-fill: black; -fx-background-radius: 10;" text="Profile" />
            </HBox>
            <Label style="-fx-text-fill: #9ec9c5; -fx-font-size: 13px;" />
        </VBox>
    </top>

    <center>
        <VBox alignment="TOP_CENTER" spacing="16.0" style="-fx-padding: 10 32 10 32;">
            <Label fx:id="openingNoticeLabel" maxWidth="Infinity" style="-fx-background-color: rgba(27,191,122,0.14); -fx-background-radius: 12; -fx-border-color: rgba(27,191,122,0.45); -fx-border-radius: 12; -fx-padding: 14 18 14 18; -fx-text-fill: #f5d76e; -fx-font-size: 14px; -fx-font-weight: bold;" text="Quy định: Nếu có bidder đặt giá trong vòng 15 giây cuối, phiên đó sẽ gia hạn thêm 15 giây" visible="true" />

            <Label fx:id="emptyStateLabel" managed="false" maxWidth="Infinity" style="-fx-background-color: rgba(212,175,55,0.12); -fx-background-radius: 12; -fx-border-color: rgba(212,175,55,0.35); -fx-border-radius: 12; -fx-padding: 14 18 14 18; -fx-text-fill: #f5d76e; -fx-font-size: 14px; -fx-font-weight: bold;" text="Hiện tại không có sản phẩm đấu giá nào khả dụng, vui lòng quay lại sau" visible="false" />

            <TableView fx:id="productTable" maxHeight="560.0" maxWidth="Infinity" prefHeight="520.0" prefWidth="1080.0" styleClass="bidder-table">
                <columns>
                    <TableColumn fx:id="nameColumn" prefWidth="250.0" text="Tên sản phẩm" />
                    <TableColumn fx:id="startPriceColumn" prefWidth="180.0" text="Giá khởi điểm" />
                    <TableColumn fx:id="currentPriceColumn" prefWidth="180.0" text="Giá hiện tại" />
                    <TableColumn fx:id="statusColumn" prefWidth="280.0" text="Trạng thái" />
                    <TableColumn fx:id="timeLeftColumn" prefWidth="150.0" text="Thời gian" />
                </columns>
            </TableView>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="14.0" style="-fx-padding: 12 32 24 32;">
            <Button onAction="#handleRefresh" prefHeight="38.0" prefWidth="110.0" style="-fx-font-weight: bold; -fx-background-color: #1bbf7a; -fx-text-fill: white; -fx-background-radius: 10;" text="Tải lại" />
            <Button mnemonicParsing="false" onAction="#handleViewDetail" prefHeight="38.0" prefWidth="120.0" style="-fx-font-weight: bold; -fx-background-color: #d4af37; -fx-text-fill: #07211f; -fx-background-radius: 10;" text="Đặt giá ngay!" />
            <Button onAction="#handleLogout" prefHeight="38.0" prefWidth="110.0" style="-fx-font-weight: bold; -fx-background-color: #b71c1c; -fx-text-fill: white; -fx-background-radius: 10;" text="Đăng xuất" />
        </HBox>
    </bottom>

</BorderPane>
