<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="640.0" prefWidth="700.0"
            style="-fx-background-color: linear-gradient(to bottom right, #012f2d, #003c3a 58%, #0a5a52);"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.auction.controller.EditProductController">

    <top>
        <VBox spacing="8.0" style="-fx-padding: 28 36 6 36;">
            <children>
                <Label style="-fx-text-fill: #d4af37; -fx-font-size: 28px; -fx-font-weight: bold; -fx-font-style: italic;"
                       text="EDIT PRODUCT" />
                <Label style="-fx-text-fill: #f6e7b0; -fx-font-size: 13px;"
                       text="Cập nhật thông tin sản phẩm và thêm ảnh nếu bạn muốn."
                       wrapText="true" />
            </children>
        </VBox>
    </top>

    <center>
        <StackPane style="-fx-padding: 14 36 36 36;">
            <children>
                <VBox maxWidth="600.0" spacing="24.0"
                      style="-fx-background-color: rgba(7, 46, 43, 0.92);
                             -fx-background-radius: 24;
                             -fx-border-color: #d4af37;
                             -fx-border-width: 1.5;
                             -fx-border-radius: 24;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.35), 24, 0.15, 0, 12);">
                    <padding>
                        <Insets bottom="28.0" left="28.0" right="28.0" top="28.0" />
                    </padding>

                    <children>
                        <GridPane hgap="16.0" vgap="18.0">
                            <columnConstraints>
                                <ColumnConstraints minWidth="120.0" prefWidth="130.0" />
                                <ColumnConstraints prefWidth="390.0" />
                            </columnConstraints>

                            <children>
                                <Label style="-fx-text-fill: #d4af37; -fx-font-size: 14px; -fx-font-weight: bold;"
                                       text="Name" />
                                <TextField fx:id="nameField" prefHeight="42.0" promptText="Nhập tên sản phẩm"
                                           style="-fx-background-color: #f8f5ea;
                                                  -fx-background-radius: 12;
                                                  -fx-border-color: #d4af37;
                                                  -fx-border-radius: 12;
                                                  -fx-border-width: 1;
                                                  -fx-text-fill: #0f1f1f;
                                                  -fx-prompt-text-fill: #7a6e47;"
                                           GridPane.columnIndex="1" />

                                <Label style="-fx-text-fill: #d4af37; -fx-font-size: 14px; -fx-font-weight: bold;"
                                       text="Description"
                                       GridPane.rowIndex="1" />
                                <VBox spacing="12.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                    <children>
                                        <TextArea fx:id="descriptionArea" prefHeight="110.0"
                                                  promptText="Nhập thông tin sản phẩm và tải ảnh nếu có (nhập thông tin là bắt buộc, tải ảnh lên là optional)"
                                                  style="-fx-control-inner-background: #f8f5ea;
                                                         -fx-background-color: #f8f5ea;
                                                         -fx-background-insets: 0;
                                                         -fx-background-radius: 12;
                                                         -fx-border-color: #d4af37;
                                                         -fx-border-radius: 12;
                                                         -fx-border-width: 1;
                                                         -fx-text-fill: #0f1f1f;
                                                         -fx-prompt-text-fill: #7a6e47;"
                                                  wrapText="true" />

                                        <VBox spacing="10.0"
                                              style="-fx-background-color: rgba(212, 175, 55, 0.08);
                                                     -fx-background-radius: 16;
                                                     -fx-border-color: rgba(212, 175, 55, 0.45);
                                                     -fx-border-radius: 16;
                                                     -fx-border-width: 1;
                                                     -fx-padding: 14;">
                                            <children>
                                                <Label style="-fx-text-fill: #d4af37; -fx-font-size: 13px; -fx-font-weight: bold;"
                                                       text="Ảnh sản phẩm (optional)" />

                                                <HBox spacing="14.0">
                                                    <children>
                                                        <StackPane prefHeight="120.0" prefWidth="170.0"
                                                                   style="-fx-background-color: rgba(248, 245, 234, 0.08);
                                                                          -fx-background-radius: 14;
                                                                          -fx-border-color: #d4af37;
                                                                          -fx-border-radius: 14;
                                                                          -fx-border-width: 1;">
                                                            <children>
                                                                <ImageView fx:id="productImagePreview"
                                                                           fitHeight="110.0"
                                                                           fitWidth="160.0"
                                                                           pickOnBounds="true"
                                                                           preserveRatio="true" />
                                                                <Label fx:id="imagePlaceholderLabel"
                                                                       style="-fx-text-fill: #f6e7b0; -fx-font-size: 12px;"
                                                                       text="Preview ảnh" />
                                                            </children>
                                                        </StackPane>

                                                        <VBox alignment="CENTER_LEFT" spacing="12.0">
                                                            <children>
                                                                <Label fx:id="imageStatusLabel"
                                                                       maxWidth="200.0"
                                                                       style="-fx-text-fill: #f8f5ea; -fx-font-size: 12px;"
                                                                       text="Chưa tải ảnh. Bạn có thể bỏ qua mục này."
                                                                       wrapText="true" />

                                                                <HBox spacing="10.0">
                                                                    <children>
                                                                        <Button onAction="#handleChooseImage"
                                                                                prefHeight="38.0"
                                                                                prefWidth="105.0"
                                                                                style="-fx-background-color: #d4af37;
                                                                                       -fx-text-fill: #002c2a;
                                                                                       -fx-font-weight: bold;
                                                                                       -fx-background-radius: 10;"
                                                                                text="Chọn ảnh" />
                                                                        <Button onAction="#handleRemoveImage"
                                                                                prefHeight="38.0"
                                                                                prefWidth="92.0"
                                                                                style="-fx-background-color: transparent;
                                                                                       -fx-text-fill: #d4af37;
                                                                                       -fx-font-weight: bold;
                                                                                       -fx-border-color: #d4af37;
                                                                                       -fx-border-radius: 10;
                                                                                       -fx-border-width: 1.2;
                                                                                       -fx-background-radius: 10;"
                                                                                text="Bỏ ảnh" />
                                                                    </children>
                                                                </HBox>
                                                            </children>
                                                        </VBox>
                                                    </children>
                                                </HBox>
                                            </children>
                                        </VBox>
                                    </children>
                                </VBox>

                                <Label style="-fx-text-fill: #d4af37; -fx-font-size: 14px; -fx-font-weight: bold;"
                                       text="Start Price"
                                       GridPane.rowIndex="2" />
                                <TextField fx:id="startPriceField" prefHeight="42.0" promptText="Nhập giá khởi điểm"
                                           style="-fx-background-color: #f8f5ea;
                                                  -fx-background-radius: 12;
                                                  -fx-border-color: #d4af37;
                                                  -fx-border-radius: 12;
                                                  -fx-border-width: 1;
                                                  -fx-text-fill: #0f1f1f;
                                                  -fx-prompt-text-fill: #7a6e47;"
                                           GridPane.columnIndex="1"
                                           GridPane.rowIndex="2" />

                                <Label style="-fx-text-fill: #d4af37; -fx-font-size: 14px; -fx-font-weight: bold;"
                                       text="Status"
                                       GridPane.rowIndex="3" />
                                <ComboBox fx:id="statusComboBox" prefHeight="42.0"
                                          style="-fx-background-color: #f8f5ea;
                                                 -fx-background-radius: 12;
                                                 -fx-border-color: #d4af37;
                                                 -fx-border-radius: 12;
                                                 -fx-border-width: 1;
                                                 -fx-text-fill: #0f1f1f;
                                                 -fx-mark-color: #003c3a;"
                                          GridPane.columnIndex="1"
                                          GridPane.rowIndex="3" />
                            </children>
                        </GridPane>

                        <HBox alignment="CENTER_RIGHT" spacing="14.0">
                            <children>
                                <Button onAction="#handleCancel" prefHeight="42.0" prefWidth="130.0"
                                        style="-fx-background-color: transparent;
                                               -fx-text-fill: #d4af37;
                                               -fx-font-weight: bold;
                                               -fx-border-color: #d4af37;
                                               -fx-border-radius: 12;
                                               -fx-border-width: 1.2;
                                               -fx-background-radius: 12;"
                                        text="Cancel" />
                                <Button onAction="#handleSave" prefHeight="42.0" prefWidth="130.0"
                                        style="-fx-background-color: #d4af37;
                                               -fx-text-fill: #002c2a;
                                               -fx-font-weight: bold;
                                               -fx-background-radius: 12;"
                                        text="Save" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </StackPane>
    </center>

</BorderPane>
