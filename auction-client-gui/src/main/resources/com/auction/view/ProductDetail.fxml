<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<StackPane prefHeight="700.0" prefWidth="1200.0" style="-fx-background-color: linear-gradient(to bottom right, #003c3a, #012724); -fx-padding: 24;" stylesheets="@../style/seller.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.controller.ProductDetailController">

   <children>
      <VBox alignment="CENTER" maxHeight="700.0" maxWidth="680.0" prefHeight="680.0" prefWidth="680.0" spacing="14.0" style="-fx-background-color: rgba(0, 26, 24, 0.72); -fx-background-radius: 24; -fx-border-color: #d4af37; -fx-border-width: 1.5; -fx-border-radius: 24; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.35), 24, 0.25, 0, 8);">
         <padding>
            <Insets bottom="22.0" left="26.0" right="26.0" top="22.0" />
         </padding>

         <children>
            <Label style="-fx-font-weight: bold; -fx-letter-spacing: 1px;" text="Thông tin sản phẩm" textFill="#d4af37">
               <font>
                  <Font size="30.0" />
               </font>
            </Label>

            <HBox prefWidth="620.0" spacing="18.0" style="-fx-background-color: rgba(255,255,255,0.06); -fx-background-radius: 16; -fx-border-color: rgba(212,175,55,0.35); -fx-border-radius: 16; -fx-padding: 18;">
               <children>
                  <VBox prefWidth="360.0" spacing="10.0">
                     <children>
                        <Label fx:id="productNameLabel" style="-fx-font-size: 15px; -fx-text-fill: #d4af37; -fx-font-weight: bold;" text="Tên:" textFill="#f4d675" />

                        <Label fx:id="descriptionLabel" maxWidth="340.0" style="-fx-font-size: 15px; -fx-text-fill: #d4af37; -fx-font-weight: bold; -fx-line-spacing: 3px;" text="Mô tả:" wrapText="true" />

                        <Label fx:id="currentPriceLabel" style="-fx-font-size: 15px; -fx-font-weight: bold;" text="Giá hiện tại:" textFill="#d4af37" />

                        <Label fx:id="statusLabel" style="-fx-font-size: 15px; -fx-text-fill: #d4af37; -fx-font-weight: bold;" text="Trạng thái:" textFill="#f4d675" />
                     </children>
                  </VBox>

                  <VBox alignment="TOP_CENTER" prefWidth="206.0" spacing="10.0">
                     <children>
                        <Label style="-fx-font-size: 15px; -fx-text-fill: #d4af37; -fx-font-weight: bold;" text="Hình ảnh" />

                        <StackPane prefHeight="174.0" prefWidth="206.0" style="-fx-background-color: rgba(248, 242, 220, 0.08); -fx-background-radius: 16; -fx-border-color: #d4af37; -fx-border-width: 1.1; -fx-border-radius: 16;">
                           <children>
                              <ImageView fx:id="productImageView" fitHeight="162.0" fitWidth="194.0" pickOnBounds="true" preserveRatio="true" />
                              <Label fx:id="imagePlaceholderLabel" maxWidth="180.0" style="-fx-text-fill: #f8f2dc; -fx-font-size: 12px; -fx-font-weight: bold;" text="No product image" wrapText="true" />
                           </children>
                        </StackPane>
                     </children>
                  </VBox>
               </children>
            </HBox>

            <HBox alignment="CENTER" prefWidth="620.0" spacing="12.0">
               <children>
                  <TextField fx:id="bidAmountField" prefHeight="38.0" prefWidth="320.0" promptText="Nhập mức giá" style="-fx-background-color: #f8f2dc; -fx-background-radius: 18; -fx-border-color: #d4af37; -fx-border-radius: 18; -fx-text-fill: #003c3a; -fx-prompt-text-fill: #6f6a58; -fx-font-weight: bold; -fx-padding: 0 16;" />

                  <Button fx:id="placeBidButton" mnemonicParsing="false" onAction="#handlePlaceBid" prefHeight="38.0" prefWidth="110.0" style="-fx-background-color: #d4af37; -fx-background-radius: 18; -fx-font-weight: bold; -fx-cursor: hand;" text="Đặt giá" textFill="#003c3a" />
               </children>
            </HBox>

            <Label style="-fx-font-weight: bold;" text="Bid History" textFill="#d4af37">
               <font>
                  <Font size="22.0" />
               </font>
            </Label>

            <TableView fx:id="bidHistoryTable" prefHeight="240.0" prefWidth="620.0" style="-fx-background-color: #f8f2dc; -fx-background-radius: 14; -fx-border-color: #d4af37; -fx-border-radius: 14;">
               <columns>
                  <TableColumn fx:id="bidderUsernameColumn" prefWidth="180.0" text="Tên Bidder" />
                  <TableColumn fx:id="bidPriceColumn" prefWidth="170.0" text="Mức giá đã đặt" />
                  <TableColumn fx:id="bidTimeColumn" prefWidth="268.0" text="Thời gian" />
               </columns>
            </TableView>

            <Button fx:id="backButton" mnemonicParsing="false" onAction="#handleBack" prefHeight="36.0" prefWidth="110.0" style="-fx-background-color: #d3d3d3; -fx-background-radius: 18; -fx-font-weight: bold; -fx-cursor: hand;" text="Thoát" textFill="#003c3a" />
         </children>
      </VBox>
   </children>
</StackPane>
