<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<StackPane prefHeight="700.0" prefWidth="1200.0" style="-fx-background-color: linear-gradient(to bottom right, #003c3a, #012724); -fx-padding: 18;" stylesheets="@../style/style.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.controller.ProductDetailController">
   <children>
      <ScrollPane fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER" style="-fx-background: transparent; -fx-background-color: transparent;">
         <content>
            <StackPane alignment="TOP_CENTER" style="-fx-background-color: transparent;">
               <children>
                  <VBox maxWidth="1120.0" prefWidth="1120.0" spacing="12.0" style="-fx-background-color: rgba(0, 26, 24, 0.72); -fx-background-radius: 24; -fx-border-color: #d4af37; -fx-border-width: 1.5; -fx-border-radius: 24; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.35), 24, 0.25, 0, 8);">
                     <padding>
                        <Insets bottom="18.0" left="20.0" right="20.0" top="18.0" />
                     </padding>

                     <children>
                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                           <children>
                              <Label maxWidth="Infinity" style="-fx-font-weight: bold; -fx-text-fill: #d4af37; -fx-letter-spacing: 1px;" text="Thông tin sản phẩm" textFill="WHITE" HBox.hgrow="ALWAYS">
                                 <font>
                                    <Font size="28.0" />
                                 </font>
                              </Label>

                              <Button fx:id="backButton" mnemonicParsing="false" onAction="#handleBack" prefHeight="36.0" prefWidth="112.0" style="-fx-background-color: #d3d3d3; -fx-background-radius: 18; -fx-font-weight: bold; -fx-cursor: hand;" text="Thoát" textFill="#003c3a" />
                           </children>
                        </HBox>

                        <HBox alignment="TOP_CENTER" spacing="14.0" VBox.vgrow="ALWAYS">
                           <children>
                              <VBox prefWidth="650.0" spacing="12.0" HBox.hgrow="ALWAYS">
                                 <children>
                                    <HBox alignment="TOP_LEFT" spacing="14.0" style="-fx-background-color: rgba(255,255,255,0.06); -fx-background-radius: 16; -fx-border-color: rgba(212,175,55,0.35); -fx-border-radius: 16; -fx-padding: 14;">
                                       <children>
                                          <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                                             <children>
                                                <Label fx:id="productNameLabel" maxWidth="Infinity" style="-fx-font-size: 16px; -fx-text-fill: white; -fx-font-weight: bold;" text="Tên:" wrapText="true" />
                                                <Label fx:id="descriptionLabel" maxWidth="Infinity" style="-fx-font-size: 14px; -fx-text-fill: white; -fx-font-weight: bold; -fx-line-spacing: 3px;" text="Mô tả:" wrapText="true" />
                                                <Label fx:id="startPriceLabel" maxWidth="Infinity" style="-fx-font-size: 14px; -fx-font-weight: bold;" text="Giá khởi điểm:" textFill="WHITE" wrapText="true" />
                                                <Label fx:id="currentPriceLabel" maxWidth="Infinity" style="-fx-font-size: 15px; -fx-font-weight: bold;" text="Giá hiện tại:" textFill="#fafafa" wrapText="true" />
                                                <Label fx:id="statusLabel" maxWidth="Infinity" style="-fx-font-size: 14px; -fx-text-fill: white; -fx-font-weight: bold;" text="Trạng thái:" textFill="#fffefe" wrapText="true" />
                                                <Label fx:id="startTimeLabel" maxWidth="Infinity" style="-fx-font-size: 13px; -fx-text-fill: white; -fx-font-weight: bold;" text="Bắt đầu:" wrapText="true" />
                                                <Label fx:id="endTimeLabel" maxWidth="Infinity" style="-fx-font-size: 13px; -fx-text-fill: white; -fx-font-weight: bold;" text="Kết thúc:" wrapText="true" />
                                             </children>
                                          </VBox>

                                          <VBox alignment="TOP_CENTER" prefWidth="210.0" spacing="8.0">
                                             <children>
                                                <Label style="-fx-font-size: 14px; -fx-text-fill: #d4af37; -fx-font-weight: bold;" text="Hình ảnh" />

                                                <StackPane prefHeight="150.0" prefWidth="210.0" style="-fx-background-color: rgba(248, 242, 220, 0.08); -fx-background-radius: 14; -fx-border-color: #d4af37; -fx-border-width: 1.1; -fx-border-radius: 14;">
                                                   <children>
                                                      <ImageView fx:id="productImageView" fitHeight="138.0" fitWidth="198.0" pickOnBounds="true" preserveRatio="true" />
                                                      <Label fx:id="imagePlaceholderLabel" maxWidth="178.0" style="-fx-text-fill: #f8f2dc; -fx-font-size: 12px; -fx-font-weight: bold;" text="Chưa có ảnh sản phẩm" textAlignment="CENTER" wrapText="true" />
                                                   </children>
                                                </StackPane>
                                             </children>
                                          </VBox>
                                       </children>
                                    </HBox>

                                    <HBox alignment="CENTER" spacing="10.0" style="-fx-background-color: rgba(255,255,255,0.06); -fx-background-radius: 16; -fx-border-color: rgba(212,175,55,0.35); -fx-border-radius: 16; -fx-padding: 12;">
                                       <children>
                                          <TextField fx:id="bidAmountField" maxWidth="Infinity" prefHeight="36.0" promptText="Nhập mức giá" style="-fx-background-color: #f8f2dc; -fx-background-radius: 18; -fx-border-color: #d4af37; -fx-border-radius: 18; -fx-text-fill: #003c3a; -fx-prompt-text-fill: #6f6a58; -fx-font-weight: bold; -fx-padding: 0 16;" HBox.hgrow="ALWAYS" />
                                          <Button fx:id="placeBidButton" mnemonicParsing="false" onAction="#handlePlaceBid" prefHeight="36.0" prefWidth="112.0" style="-fx-background-color: #d4af37; -fx-background-radius: 18; -fx-font-weight: bold; -fx-cursor: hand;" text="Đặt giá" textFill="#003c3a" />
                                       </children>
                                    </HBox>

                                    <VBox spacing="8.0" style="-fx-background-color: rgba(248,242,220,0.06); -fx-background-radius: 14; -fx-border-color: rgba(212,175,55,0.55); -fx-border-radius: 14; -fx-padding: 10;">
                                       <children>
                                          <Label style="-fx-font-weight: bold;" text="Biểu đồ giá" textFill="#d4af37">
                                             <font>
                                                <Font size="18.0" />
                                             </font>
                                          </Label>

                                          <LineChart fx:id="priceChart" animated="false" createSymbols="true" horizontalGridLinesVisible="true" legendVisible="false" minHeight="210.0" prefHeight="230.0" styleClass="price-chart" verticalGridLinesVisible="true">
                                             <xAxis>
                                                <NumberAxis fx:id="priceChartXAxis" autoRanging="false" label="Thời gian" />
                                             </xAxis>
                                             <yAxis>
                                                <NumberAxis fx:id="priceChartYAxis" autoRanging="false" label="Giá thầu" />
                                             </yAxis>
                                          </LineChart>
                                       </children>
                                    </VBox>
                                 </children>
                              </VBox>

                              <VBox prefWidth="420.0" spacing="8.0" style="-fx-background-color: rgba(255,255,255,0.06); -fx-background-radius: 16; -fx-border-color: rgba(212,175,55,0.35); -fx-border-radius: 16; -fx-padding: 12;" HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label style="-fx-font-weight: bold;" text="Lịch sử đặt giá" textFill="#d4af37">
                                       <font>
                                          <Font size="20.0" />
                                       </font>
                                    </Label>

                                    <TableView fx:id="bidHistoryTable" prefHeight="470.0" styleClass="bidder-table" VBox.vgrow="ALWAYS">
                                       <columns>
                                          <TableColumn fx:id="bidderUsernameColumn" prefWidth="130.0" text="Bidder" />
                                          <TableColumn fx:id="bidPriceColumn" prefWidth="140.0" text="Mức giá" />
                                          <TableColumn fx:id="bidTimeColumn" prefWidth="150.0" text="Thời gian" />
                                       </columns>
                                    </TableView>
                                 </children>
                              </VBox>
                           </children>
                        </HBox>
                     </children>
                  </VBox>
               </children>
            </StackPane>
         </content>
      </ScrollPane>
   </children>
</StackPane>
